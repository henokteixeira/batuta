#!/bin/bash
# Run inside the Orchestrator terminal of a Batuta workspace, with Maestro Mode on; rerun to clean what an older workflow left.
set -u
B="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEFINER="${DEFINER:-Definidor}"
LIST=$(maestri list 2>&1)
if echo "$LIST" | grep -q "maestro: false"; then
  echo "This terminal is not the Maestro. Toggle Maestro Mode on it and run again."; exit 1
fi

have() { echo "$LIST" | grep -q "name: \"$1\""; }
template() { cat "$B/templates/notes/$1.md"; }

for old in painel "pra você" achados "como funciona" board "how it works"; do
  if have "$old"; then maestri note delete "$old" >/dev/null 2>&1 && echo "removed note '$old'"; fi
done

for n in "for you" findings round; do
  if ! have "$n"; then
    maestri note create "$(template "$n")" --name "$n" >/dev/null 2>&1 && echo "created note '$n'"
  else
    echo "note '$n' already there"
  fi
done

if echo "$LIST" | grep -q "name: \"$DEFINER\""; then
  for n in "for you" findings round; do
    maestri connect "$n" "$DEFINER" >/dev/null 2>&1 && echo "wired '$n' <-> '$DEFINER'"
  done
else
  echo "no terminal named '$DEFINER' is connected to you: wire the Definer to this terminal in the canvas and run again for the ropes"
fi

ROUTINES=$(maestri routine list 2>&1)
for old in "morning state" "evening handoff" "evening round check" "for you reminder"; do
  if echo "$ROUTINES" | grep -q "$old"; then maestri routine delete "$old" >/dev/null 2>&1 && echo "removed routine '$old'"; fi
done

echo; maestri list
